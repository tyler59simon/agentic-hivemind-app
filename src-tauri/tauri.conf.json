{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivemind",
  "version": "0.1.0",
  "identifier": "dev.hivemind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hivemind",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://hmfile.localhost hmfile://localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://hmfile.localhost hmfile://localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Editor"
      },
      {
        "ext": [
          "hmdoc"
        ],
        "name": "Hivemind rich page",
        "description": "Hivemind rich page",
        "role": "Editor"
      },
      {
        "ext": [
          "canvas"
        ],
        "name": "JSON Canvas board",
        "description": "JSON Canvas board",
        "role": "Editor"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Mermaid diagram",
        "description": "Mermaid diagram",
        "role": "Editor"
      },
      {
        "ext": [
          "drawio",
          "dio"
        ],
        "name": "Draw.io diagram",
        "description": "Draw.io diagram",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
